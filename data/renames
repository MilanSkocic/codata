#!/usr/bin/env bash
#
# Derive the quantity rename map from the adjustments themselves.
#
# NIST renames quantities between adjustments: what CODATA 2014 calls
# ELECTRIC_CONSTANT, CODATA 2018 calls VACUUM_ELECTRIC_PERMITTIVITY. Pairing
# such names by spelling is unsafe -- ELEMENTARY_CHARGE_OVER_H (2014) and
# ELEMENTARY_CHARGE_OVER_H_BAR (2018) look like a rename but differ by 2*pi.
#
# A pair is therefore only accepted when the two entries carry compatible units
# and their values agree to within 5 sigma of their combined quoted
# uncertainties, and when that match is unique in both directions. Anything
# else is reported as retired or new, and is left unaliased.
#
# Usage: ./renames build/*.toml

awk '
BEGIN{
    FS = " = "
    print "# Quantity renames across CODATA adjustments. Generated by data/renames;"
    print "# regenerate with \"make -C data update_renames\" and review any change."
    print "#"
    print "# A pair is accepted only when the units are compatible and the values agree"
    print "# to within 5 sigma of their combined quoted uncertainties, uniquely in both"
    print "# directions. Lines marked #retired, #new or #ambiguous are NOT aliased."
    print "#"
    print "# old_name\tnew_name\tfrom\tto\tsigma"
    # Unit spellings NIST changed without changing the quantity. Both members
    # of a group are treated as the same unit.
    unit_group["eV s"] = 1
    unit_group["eV Hz^-1"] = 1
}
FNR==1{
    year = FILENAME
    sub(/.*codata_constants_/, "", year)
    sub(/\.toml$/, "", year)
    if(!(year in seen_year)){seen_year[year] = 1; nyears++; years[nyears] = year}
}
/^\[.*\]/{
    key = $0
    gsub(/\[/, "", key)
    gsub(/\]/, "", key)
    present[year, key] = 1
    n[year]++
    keys[year, n[year]] = key
    next
}
/^value/{      v = $2; gsub(/"/, "", v); value[year, key]       = v + 0; next }
/^uncertainty/{u = $2; gsub(/"/, "", u); uncertainty[year, key] = u + 0; next }
/^unit/{       w = $2; gsub(/"/, "", w); unit[year, key]        = w;     next }

function same_unit(a, b){
    if(a == b){return 1}
    if((a in unit_group) && (b in unit_group)){return 1}
    return 0
}
# Values agree within 5 sigma of their combined quoted uncertainties. Exact
# constants (zero uncertainty on both sides) must agree exactly.
function agree(y1, k1, y2, k2,   d, s){
    d = value[y1, k1] - value[y2, k2]
    if(d < 0){d = -d}
    s = sqrt(uncertainty[y1, k1]^2 + uncertainty[y2, k2]^2)
    if(s == 0){return d == 0 ? 0 : -1}
    return (d <= 5 * s) ? d / s : -1
}
END{
    # sort the years ascending
    for(i = 1; i <= nyears; i++){
        for(j = i + 1; j <= nyears; j++){
            if(years[j] + 0 < years[i] + 0){t = years[i]; years[i] = years[j]; years[j] = t}
        }
    }

    for(i = 1; i < nyears; i++){
        y1 = years[i]; y2 = years[i + 1]

        ndrop = 0; nadd = 0
        for(a = 1; a <= n[y1]; a++){k = keys[y1, a]; if(!present[y2, k]){dropped[++ndrop] = k}}
        for(a = 1; a <= n[y2]; a++){k = keys[y2, a]; if(!present[y1, k]){added[++nadd] = k}}

        # count candidate matches in both directions, so that an ambiguous
        # pairing is reported rather than silently resolved
        for(a = 1; a <= ndrop; a++){
            nc[a] = 0
            for(b = 1; b <= nadd; b++){
                if(!same_unit(unit[y1, dropped[a]], unit[y2, added[b]])){continue}
                s = agree(y1, dropped[a], y2, added[b])
                if(s >= 0){nc[a]++; cand[a] = b; sig[a] = s; back[b]++}
            }
        }

        for(a = 1; a <= ndrop; a++){
            if(nc[a] == 1 && back[cand[a]] == 1){
                printf "%s\t%s\t%s\t%s\t%.2f\n", dropped[a], added[cand[a]], y1, y2, sig[a]
            }
            else if(nc[a] == 0){
                printf "#retired\t%s\t%s\t%s\t-\n", dropped[a], y1, y2
            }
            else{
                printf "#ambiguous\t%s\t%s\t%s\t-\n", dropped[a], y1, y2
            }
        }
        for(b = 1; b <= nadd; b++){
            if(back[b] == 0){printf "#new\t%s\t%s\t%s\t-\n", added[b], y1, y2}
        }

        delete dropped; delete added; delete nc; delete cand; delete sig; delete back
    }
}
' "$@"
