#!/usr/bin/env bash
#
# Emit the quantity key: one enumerator per canonical quantity, with the
# enumerator value fixed by the position of the name in quantities.txt so that
# adding an adjustment never moves an existing value. Quantities NIST renamed
# get a second enumerator under the older spelling, sharing the same value.
#
# Usage: ./gen_quantities {c|f90|py}

lang="$1"

awk -v lang="$lang" '
BEGIN{
    n = 0
}
# renames.tsv: old -> new. Names linked by renames form one equivalence class
# and share a single enumerator; quantities.txt says which member names it.
FILENAME ~ /renames\.tsv$/{
    if($0 ~ /^#/){next}
    split($0, pair, "\t")
    newof[pair[1]] = pair[2]
    known[pair[1]] = 1
    known[pair[2]] = 1
    next
}
/^#/{next}
NF==0{next}
{
    q[n] = $0
    n++
}
# newest spelling of a quantity: follow the rename chain to its end
function root(k,   hops){
    hops = 0
    while((k in newof) && hops < 64){k = newof[k]; hops++}
    return k
}
# other spellings of the same quantity, as a space-separated list
function class_of(c,   k, rc, out){
    rc = root(c)
    out = ""
    for(k in known){
        if(k == c){continue}
        if(root(k) != rc){continue}
        out = out (out == "" ? "" : " ") k
    }
    return out
}
END{
    if(lang == "c"){
        print ""
        print "//------------------------------------------------------------------------"
        print "// QUANTITY KEY"
        print "//------------------------------------------------------------------------"
        print "//{{{"
        print "/** Stable key for a physical quantity, valid across adjustments. */"
        print "enum codata_quantity{"
        print "CODATA_Q_UNKNOWN = -1,"
        for(i = 0; i < n; i++){
            print "CODATA_Q_"q[i]" = "i","
        }
        print "/* Aliases: quantities renamed by NIST, sharing the canonical value. */"
        for(i = 0; i < n; i++){
            cl = class_of(q[i])
            if(cl == ""){continue}
            m = split(cl, a, " ")
            for(j = 1; j <= m; j++){
                print "CODATA_Q_"a[j]" = CODATA_Q_"q[i]","
            }
        }
        print "CODATA_Q_COUNT = "n
        print "};"
        print "//}}}"
    }
    else if(lang == "f90"){
        print "! SPDX-License-Identifier: MIT"
        print ""
        print "!======================================================================="
        print "! MODULE: CODATA_QUANTITY"
        print "!======================================================================="
        print "!{{{1"
        print "module codata__quantity"
        print "!! Stable key for a physical quantity, valid across adjustments."
        print "!! Autogenerated."
        print "!! Named Q_* rather than CODATA_Q_* as in C and Python, because"
        print "!! Fortran limits a name to 63 characters and CODATA_Q_ plus the"
        print "!! longest quantity name exceeds that."
        print "use stdlib_kinds, only: int32"
        print "implicit none(type,external)"
        print "private"
        print ""
        print ""
        print "!-----------------------------------------------------------------------"
        print "! QUANTITY KEY"
        print "!-----------------------------------------------------------------------"
        print "!{{{2"
        # Fortran limits a name to 63 characters, which CODATA_Q_ plus the
        # longest quantity name exceeds, so the Fortran keys are prefixed Q_.
        print "integer(int32), parameter, public :: Q_UNKNOWN = -1_int32"
        for(i = 0; i < n; i++){
            if(length("Q_"q[i]) > 63){
                print "gen_quantities: Fortran name too long: Q_"q[i] > "/dev/stderr"
                exit 1
            }
            print "integer(int32), parameter, public :: Q_"q[i]" = "i"_int32"
        }
        print "!-----------------------------------------------------------------------"
        print "!}}}"
        print ""
        print ""
        print "!-----------------------------------------------------------------------"
        print "! ALIASES FOR QUANTITIES RENAMED BY NIST"
        print "!-----------------------------------------------------------------------"
        print "!{{{2"
        for(i = 0; i < n; i++){
            cl = class_of(q[i])
            if(cl == ""){continue}
            m = split(cl, a, " ")
            for(j = 1; j <= m; j++){
                if(length("Q_"a[j]) > 63){
                    print "gen_quantities: Fortran name too long: Q_"a[j] > "/dev/stderr"
                    exit 1
                }
                print "integer(int32), parameter, public :: Q_"a[j]" = Q_"q[i]
            }
        }
        print "!-----------------------------------------------------------------------"
        print "!}}}"
        print ""
        print ""
        print "!-----------------------------------------------------------------------"
        print "! NUMBER OF QUANTITIES"
        print "!-----------------------------------------------------------------------"
        print "!{{{2"
        print "integer(int32), parameter, public :: Q_COUNT = "n"_int32"
        print "!-----------------------------------------------------------------------"
        print "!}}}"
        print "end module codata__quantity"
    }
    else if(lang == "py"){
        print "# SPDX-License-Identifier: MIT"
        print "\"\"\"Stable key for a physical quantity, valid across adjustments.\"\"\""
        print "import enum"
        print ""
        print "__all__ = [\"Quantity\", \"CODATA_Q_COUNT\"]"
        print ""
        print ""
        print "class Quantity(enum.IntEnum):"
        print "    \"\"\"Quantity key. Renamed quantities appear under both spellings.\"\"\""
        for(i = 0; i < n; i++){
            print "    "q[i]" = "i
        }
        print ""
        print "    # Aliases: quantities renamed by NIST, sharing the canonical value."
        for(i = 0; i < n; i++){
            cl = class_of(q[i])
            if(cl == ""){continue}
            m = split(cl, a, " ")
            for(j = 1; j <= m; j++){
                print "    "a[j]" = "i
            }
        }
        print ""
        print ""
        print "CODATA_Q_COUNT = "n
    }
    else{
        print "gen_quantities: unknown language \""lang"\"" > "/dev/stderr"
        exit 1
    }
}
' renames.tsv quantities.txt
