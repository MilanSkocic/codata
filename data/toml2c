#!/usr/bin/env bash

. ./common
latest_year=$(gly)

fname="$1"
name=$(basename -s .toml $fname)
year="${name##*_}"

suffix="_$year"
if [[ "$year" == "$latest_year" ]]; then suffix=""; fi

awk -v suffix="$suffix" -v latest_year="$latest_year" -v year="$year" '
# First file is renames.tsv: the reviewed map of quantities NIST renamed
# between adjustments. Each vintage carries exactly one name of a renamed
# pair; the other is emitted as an alias so that code written against either
# spelling compiles against every adjustment.
NR==FNR{
    if($0 ~ /^#/){next}
    split($0, r, "\t")
    newof[r[1]] = r[2]
    oldof[r[2]] = r[1]
    next
}
function alias_of(k){
    if(k in newof){return newof[k]}
    if(k in oldof){return oldof[k]}
    return ""
}
function emit_c(sym, nist, val, unc, un, doc){
    print "const struct codata_constant_type "sym" = {"
    print nist","
    print val","
    print unc","
    print un
    print "};/** "doc" */"
    print ""
}
BEGIN{
    print "/* SPDX-License-Identifier: MIT */"
    print ""
    print "//======================================================================"
    if(suffix==""){
        print "// MODULE: CODATA_CONSTANTS_"year
    }
    else{
        print "// MODULE: CODATA_CONSTANTS"suffix
    }
    print "//======================================================================"
    print "//{{{1"
    print "#include <stdlib.h>"
    print "#include \"codata.h\""
    print ""
    print "//----------------------------------------------------------------------"
    print "// CONSTANTS"
    print "//----------------------------------------------------------------------"
    print "//{{{2"
    i=0
}
/^\[.*\]/{
    gsub(/\[/,"")
    gsub(/\]/,"")
    bare=$0
    var=$0 suffix
    print "const struct codata_constant_type "var" = {"
}
/^name/{
    split($0, x, " = ")
    print x[2]","
    name = x[2]
    gsub(/"/,"",name)
    i++
    vars[i]=var
    bares[i]=bare
    docs[i]=name
    names[i]=x[2]
}
/^value/{
    gsub(/"/, "")
    split($0, x, " = ")
    print x[2]","
    values[i]=x[2]
}
/^uncertainty/{
    gsub(/"/, "")
    split($0, x, " = ")
    print x[2]","
    uncertainties[i]=x[2]
}
/^unit/{
    split($0, x, " = ")
    print x[2]
    print "};/** "name" */"
    units[i]=x[2]
}
NF==0{
    print ""
}
END{
    print "//}}}"
    print ""
    print ""
    print "//----------------------------------------------------------------------"
    print "// ARRAY OF CONSTANTS"
    print "//----------------------------------------------------------------------"
    print "//{{{2"
    print "const struct codata_constant_type *cc"suffix"[] = {" 
    for (j in vars){
        print "&"vars[j]","
    }
    print "NULL,"
    print "};"

    # The latest adjustment is also exposed under its year-suffixed name, so
    # that a caller can pin to it before the next adjustment is released.
    # The unsuffixed names above are kept as aliases meaning "current".
    if(suffix==""){
        print "//}}}"
        print ""
        print ""
        print "//----------------------------------------------------------------------"
        print "// CONSTANTS - YEAR-SUFFIXED NAMES FOR THE LATEST ADJUSTMENT"
        print "//----------------------------------------------------------------------"
        print "//{{{2"
        for (j=1; j<=i; j++){
            print "const struct codata_constant_type "bares[j]"_"year" = {"
            print names[j]","
            print values[j]","
            print uncertainties[j]","
            print units[j]
            print "};/** "docs[j]" */"
            print ""
        }
        print "//}}}"
        print ""
        print ""
        print "//----------------------------------------------------------------------"
        print "// ARRAY OF CONSTANTS - YEAR-SUFFIXED"
        print "//----------------------------------------------------------------------"
        print "//{{{2"
        print "const struct codata_constant_type *cc_"year"[] = {"
        for (j=1; j<=i; j++){
            print "&"bares[j]"_"year","
        }
        print "NULL,"
        print "};"
    }

    # Aliases for quantities NIST renamed. These are deliberately left out of
    # the cc arrays, which list each constant once.
    nalias = 0
    for (j=1; j<=i; j++){
        if(alias_of(bares[j]) != ""){nalias++}
    }
    if(nalias > 0){
        print "//}}}"
        print ""
        print ""
        print "//----------------------------------------------------------------------"
        print "// CONSTANTS - ALIASES FOR QUANTITIES RENAMED BY NIST"
        print "//----------------------------------------------------------------------"
        print "//{{{2"
        for (j=1; j<=i; j++){
            a = alias_of(bares[j])
            if(a == ""){continue}
            emit_c(a"_"year, names[j], values[j], uncertainties[j], units[j], docs[j])
            if(suffix == ""){
                emit_c(a, names[j], values[j], uncertainties[j], units[j], docs[j])
            }
        }
    }
}
' renames.tsv "$1"
